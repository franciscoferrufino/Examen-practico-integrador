# ==============================================================================
# CONFIGURACIÓN DE VARIABLES DE ENTORNO - SISTEMA TECNO-UAM (EJEMPLO SIN SECRETOS)
# Copie este archivo como `.env` en la raíz o en `backend/.env` antes de ejecutar
# ==============================================================================

# Configuración del Servidor Backend
SERVER_PORT=8080

# Configuración de Base de Datos SQL Server
DB_URL=jdbc:sqlserver://localhost:1433;databaseName=TecnoUAM;encrypt=true;trustServerCertificate=true
DB_USERNAME=tecnouam_user
DB_PASSWORD=REEMPLAZAR_CON_PASSWORD_SQL_SERVER

# Configuración de Seguridad JWT (Mínimo 32 caracteres / 256 bits para HMAC-SHA256)
JWT_SECRET=REEMPLAZAR_CON_CLAVE_SECRETA_JWT_MINIMO_32_CARACTERES
JWT_EXPIRATION_MS=3600000

# Configuración de CORS para el Frontend React
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Cuentas iniciales de prueba (reproducibles mediante DataInitializer)
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=REEMPLAZAR_CON_PASSWORD_ADMIN
APP_USER_USERNAME=user
APP_USER_PASSWORD=REEMPLAZAR_CON_PASSWORD_USER
